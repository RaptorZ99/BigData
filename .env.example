# ─────────────────────────────────────────────────────────────────────────────
#  EDS CHU — variables d'environnement
#
#  `make env` (appelé par `make demo`) crée le .env à partir de ce modèle et
#  remplace TOUS les secrets ci-dessous par des valeurs tirées au hasard. Aucune
#  action manuelle n'est requise.
#
#  Chaque secret d'exemple porte la marque `change_me` : c'est ce qui permet au
#  pipeline de les détecter et de refuser de les prendre pour de vrais secrets.
#  Ne remplacez jamais une valeur d'exemple par une autre valeur d'exemple qui
#  aurait l'air d'un vrai mot de passe — elle passerait le contrôle.
#
#  Le .env réel est gitignoré : il ne doit JAMAIS être commité.
# ─────────────────────────────────────────────────────────────────────────────

# ── Pseudonymisation ─────────────────────────────────────────────────────────
# SECRET. Clé HMAC-SHA256 servant à pseudonymiser les identifiants patients.
# `make env` en génère un aléatoire ; cette valeur d'exemple est refusée au
# démarrage, car un sel public rendrait les pseudonymes réversibles.
# Stable dans le temps : le changer casse toutes les jointures de l'entrepôt
# (il faudrait re-pseudonymiser l'intégralité du lake — cf. docs/EXPLOITATION.md).
EDS_SALT=remplace-moi-par-openssl-rand-hex-32

# ── ClickHouse ───────────────────────────────────────────────────────────────
# Hôte vu depuis le CLI Python (hors Docker). Metabase, lui, joint le conteneur
# par son nom de service `clickhouse` sur le réseau Docker interne.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# Compte technique du pipeline (admin : DDL, RBAC, chargements).
# ⚠ Ce mot de passe est lu par Docker à la création du conteneur ClickHouse :
# le changer sur un entrepôt déjà démarré suppose un `make reset`.
CLICKHOUSE_ETL_USER=chu_etl
CLICKHOUSE_ETL_PASSWORD=etl_change_me

# Comptes de restitution, en lecture seule sur leur propre base gold.
# C'est le socle du cloisonnement RGPD : chaque usage a son user SQL.
CLICKHOUSE_PILOTAGE_PASSWORD=pilotage_change_me
CLICKHOUSE_RECHERCHE_PASSWORD=recherche_change_me

# ── Metabase ─────────────────────────────────────────────────────────────────
MB_URL=http://localhost:3000
# Hôte ClickHouse tel que Metabase le voit (nom de service Docker).
MB_CLICKHOUSE_HOST=clickhouse
MB_CLICKHOUSE_PORT=8123

# Comptes Metabase. Même marque `change_me` que ci-dessus : le compte
# d'administration ouvre l'accès aux deux connexions, il ne doit pas rester à
# une valeur publiée dans un dépôt Git.
MB_ADMIN_EMAIL=admin@chu.local
MB_ADMIN_PASSWORD=Admin_change_me_2026
MB_PILOTAGE_EMAIL=pilotage@chu.local
MB_PILOTAGE_PASSWORD=Pilotage_change_me_2026
MB_RECHERCHE_EMAIL=recherche@chu.local
MB_RECHERCHE_PASSWORD=Recherche_change_me_2026

# ── Chemins ──────────────────────────────────────────────────────────────────
# Dépôt du CHU : LECTURE SEULE, ne jamais y écrire.
EDS_SOURCE_DIR=./source-filestorage
# Zone de travail : copie pseudonymisée, montée en lecture seule dans ClickHouse.
EDS_LAKE_DIR=./data/lake

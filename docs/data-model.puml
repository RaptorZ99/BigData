@startuml eds-data-model
title <b>EDS CHU — Modèle de données ClickHouse</b>\n<size:12>Médaillon : bronze (typé) → silver (constellation : 4 étoiles — 1 par fait — sur dimensions conformées) → gold (KPI par usage)</size>

hide circle
hide empty members
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam titleFontSize 16
skinparam nodesep 25
skinparam ranksep 40
skinparam entity {
  BackgroundColor White
  BorderColor #37474F
  FontSize 11
}
skinparam package {
  BorderColor #78909C
  FontStyle bold
  FontSize 13
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
  FontSize 10
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
  FontSize 11
}
skinparam ArrowColor #37474F

' ══════════════════════════ BRONZE ══════════════════════════
package "eds_bronze — tables typées, append-only, PARTITION BY _ingest_date" as bronze #ECEFF1 {

  entity "**patients**" as b_patients {
    patient_pseudo : String
    birth_year : UInt16
    {field} sex : LowCardinality(String)
    {field} region_code : LowCardinality(String)
  }

  entity "**sejours**" as b_sejours {
    stay_id : String
    patient_pseudo : String
    {field} service_code : LowCardinality(String)
    admission_ts : DateTime
    {field} discharge_ts : Nullable(DateTime)
    {field} admission_mode : LowCardinality(String)
    {field} discharge_mode : LowCardinality(Nullable(String))
  }

  entity "**diagnostics**" as b_diagnostics {
    stay_id : String
    {field} code_cim10 : LowCardinality(String)
    {field} diag_type : LowCardinality(String)
  }

  entity "**monitoring**" as b_monitoring {
    stay_id : String
    ts : DateTime
    heart_rate : Int32
    spo2 : Int32
    temp_c : Float32
  }

  entity "**services** (réf.)" as b_services {
    service_code : String
    service_label : String
  }

  entity "**cim10** (réf.)" as b_cim10 {
    code_cim10 : String
    libelle : String
  }

  entity "**actes**\n<i>dépôt du 29 août</i>" as b_actes #E0F2F1 {
    stay_id : String
    {field} code_ccam : LowCardinality(String)
    acte_ts : DateTime
  }

  entity "**description_service** (réf.)\n<i>dépôt du 29 août</i>" as b_descr #E0F2F1 {
    service_code : String
    categorie · pole
    {field} capacite_lits : Nullable(UInt16)
  }

  entity "**ccam** (réf.)\n<i>dépôt du 29 août</i>" as b_ccam #E0F2F1 {
    code_ccam : String
    libelle : String
    {field} tarif_euros : Nullable(UInt32)
  }
}

' ═══ SILVER — CONSTELLATION : 3 ÉTOILES, DIMENSIONS CONFORMÉES ═══
package "eds_silver — constellation : 4 étoiles (1 par fait) sur dimensions conformées (rebuild complet à chaque run)" as silver #E8F5E9 {

  entity "**dim_service**\n<i>dimension conformée</i>" as dim_service #FFFDE7 {
    * **service_code** : String <<PK>>
    --
    service_label : String
    <i>complétée le 29 août :</i>
    categorie · pole
    {field} capacite_lits : Nullable
    est_decrit : Bool
    <i>non décrit → « non renseigne »,</i>
    <i>capacité NULL, jamais inventée</i>
    ..lignage..
  }

  entity "**dim_ccam**\n<i>dimension</i>" as dim_ccam #FFFDE7 {
    * **code_ccam** : String <<PK>>
    --
    libelle : String
    {field} tarif_euros : Nullable(UInt32)
    ..lignage..
  }

  entity "**dim_patient**\n<i>dimension conformée</i>" as dim_patient #FFFDE7 {
    * **patient_pseudo** : String <<PK>>
    --
    birth_year : UInt16
    {field} sex : String (M/F)
    region_code : String
    first_seen_ingest_date : Date
    ..lignage..
  }

  entity "**dim_cim10**\n<i>dimension</i>" as dim_cim10 #FFFDE7 {
    * **code_cim10** : String <<PK>>
    --
    libelle : String
    ..lignage..
  }

  entity "**fact_monitoring**\n<i>grain : 1 relevé de constantes</i>" as fact_monitoring {
    # service_code <<FK dim_service>>
    stay_id <<DD>> · ts : DateTime
    releve_date : Date
    --
    <i>mesures</i>
    heart_rate · spo2 · temp_c
    --
    <i>flags</i>
    alert_hr / alert_spo2 / alert_temp
    <i>FC < 50 ou > 100 · SpO2 < 92 · T° > 38,5</i>
    is_alert · is_after_discharge : Bool
  }

  entity "**fact_sejour**\n<i>grain : 1 séjour hospitalier</i>" as fact_sejour {
    * **stay_id** : String <<PK, DD>>
    --
    # patient_pseudo <<FK dim_patient>>
    # service_code <<FK dim_service>>
    admission_ts : DateTime
    {field} discharge_ts : Nullable(DateTime)
    admission_date · discharge_date : Date
    admission_mode · discharge_mode
    --
    <i>mesures & flags</i>
    duree_heures · duree_jours : Nullable
    is_ongoing · is_deces : Bool
    is_admission_urgence : Bool
    is_service_urgences : Bool
    is_post_mortem_anomaly : Bool
  }

  entity "**fact_diagnostic**\n<i>grain : 1 code CIM-10 posé sur 1 séjour</i>" as fact_diagnostic {
    # patient_pseudo <<FK dim_patient>>
    # code_cim10 <<FK dim_cim10>>
    stay_id <<DD>>
    diag_type : principal | associe
    is_principal : Bool
    --
    {field} <i>fait sans mesure (factless)</i>
    <i>→ comptages de cohortes</i>
    --
    <i>dénormalisation du séjour parent</i>
    admission_date · service_code
    <i>→ évite la jointure fact-to-fact</i>
  }

  entity "**fact_acte**\n<i>grain : 1 acte médical</i>" as fact_acte {
    # service_code <<FK dim_service>>
    # code_ccam <<FK dim_ccam>>
    stay_id <<DD>> · acte_ts : DateTime
    acte_date : Date
    --
    <i>mesure</i>
    {field} montant_euros : Nullable (tarif T2A)
    --
    <i>flags</i>
    is_code_inconnu · is_hors_sejour : Bool
    --
    <i>service résolu depuis le référentiel</i>
    <i>des séjours, rangé sur le fait :</i>
    <i>« actes par service » = GROUP BY</i>
  }

  entity "**actes_rejets**" as s_actes_rejets #FFEBEE {
    reject_reason : String
    <i>séjour absent du dépôt</i>
    ..colonnes d'origine + lignage..
  }

  entity "**sejours_rejets**" as s_sejours_rejets #FFEBEE {
    reject_reason : String
    reject_label : String
    ..colonnes d'origine + lignage..
  }

  entity "**monitoring_rejets**" as s_monitoring_rejets #FFEBEE {
    reject_reason : String
    <i>motifs concaténés par « + »</i>
    ..colonnes d'origine + lignage..
  }

  note "<b>stay_id = dimension dégénérée (DD)</b> portée par les 4 faits :\nelle relie logiquement les étoiles (drill-across)\n<b>sans aucune jointure fact-to-fact</b>.\nFK propagées au build silver depuis le référentiel des séjours\n(patient_pseudo → fact_diagnostic, service_code → fact_monitoring et fact_acte)." as n_dd

  note "<b>Un rejet ne vaut que pour la table où vit l'anomalie.</b>\nQ2 invalide les HORODATAGES du séjour, pas le séjour :\nfact_sejour l'écarte (6 729 / 6 797), mais ses diagnostics\net ses relevés restent dans l'entrepôt — ils résolvent leur\npatient et leur service depuis le référentiel complet.\nLa cascade coûtait 15 patients de prévalence et 528 relevés." as n_rejet
}

' Étoile 1 — fact_sejour (DMS, urgences, réadmissions, activité)
dim_patient ||--o{ fact_sejour : patient_pseudo
dim_service ||--o{ fact_sejour : service_code
' Étoile 2 — fact_monitoring (alertes constantes / jour / service)
dim_service ||--o{ fact_monitoring : service_code
' Étoile 3 — fact_diagnostic (prévalence, cohortes, démographie)
dim_patient ||--o{ fact_diagnostic : patient_pseudo
dim_cim10 ||--o{ fact_diagnostic : code_cim10
' Étoile 4 — fact_acte (actes par service et par type, densité par lit, T2A)
dim_service ||--o{ fact_acte : service_code
dim_ccam ||--o{ fact_acte : code_ccam

' ══════════════════════ GOLD PILOTAGE ═══════════════════════
package "eds_gold_pilotage — user SQL : chu_pilotage (SELECT only)" as gold_p #E3F2FD {

  entity "**kpi_dms_service**\n<i>KPI 1</i>" as g_dms {
    grain : <b>service</b>
    --
    nb_sejours · dms_jours
    dms_heures · médiane / min / max
  }

  entity "**kpi_urgences_jour**\n<i>KPI 3</i>" as g_urg {
    grain : <b>jour d'admission</b>
    --
    nb_passages
    nb_encore_presents
    duree_moy_heures
  }

  entity "**kpi_readmissions_30j**\n<i>KPI 2</i>" as g_readm {
    grain : <b>établissement</b> (1 ligne)
    --
    nb_sejours
    nb_readmissions_30j
    taux_readmission_30j_pct
    --
    <i>borne basse : la fenêtre de 30 j</i>
    <i>n'est jamais complète</i>
  }

  entity "**kpi_readmissions_service**" as g_readm_svc {
    grain : <b>service</b>
    --
    nb_sejours · nb_readmissions_30j
    taux_readmission_30j_pct
    --
    <i>se réconcilie avec le global</i>
    <i>par construction (test dbt)</i>
  }

  entity "**kpi_alertes_jour**\n<i>KPI 4</i>" as g_alert_j {
    grain : <b>jour</b>
    --
    nb_releves · nb_alertes
    taux_alertes_pct
    {field} détail FC / SpO2 / T°
  }

  entity "**kpi_alertes_service**" as g_alert_svc {
    grain : <b>service</b>
    --
    nb_releves · nb_alertes
    {field} détail FC / SpO2 / T°
    nb_sejours_monitores
  }

  entity "**kpi_activite_service**" as g_act {
    grain : jour × service
    --
    admissions · sorties
    deces · sejours_en_cours
    <i>cumul sur un calendrier</i>
    <i>reconstruit jour par jour</i>
  }

  entity "**kpi_flux**" as g_flux {
    grain : jour × sens × mode
    --
    répartition admission_mode
    et discharge_mode
  }

  entity "**kpi_qualite_pipeline**" as g_qual {
    grain : run × règle
    --
    {field} nature (rejet / signalement)
    lues · conservées
    écartées · signalées
  }

  entity "**kpi_synthese**" as g_synth {
    grain : 1 ligne
    --
    chiffres clés des tuiles
    {field} (séjours, DMS, réadmissions,
    alertes, séjours en cours)
    --
    <i>chaque valeur est reprise telle</i>
    <i>quelle d'une autre table gold</i>
  }

  entity "**kpi_ingestion**" as g_ing {
    grain : fichier × jour
    --
    domaine · fichier source
    lignes chargées · statut
  }

  entity "**kpi_activite_categorie**\n<i>évolution · KPI 1</i>" as g_cat #E0F2F1 {
    grain : <b>catégorie de service</b>
    --
    nb_services · nb_sejours
    nb_sejours_termines · dms_jours
    <i>« non renseigne » = service</i>
    <i>absent de la description</i>
  }

  entity "**kpi_actes_service**\n<i>évolution · KPI 2, 4, 5</i>" as g_actes_svc #E0F2F1 {
    grain : <b>service</b>
    --
    nb_actes · actes_par_sejour
    capacite_lits · actes_par_lit
    montant_facture_euros
    --
    <i>drill-across : deux faits agrégés</i>
    <i>séparément, joints sur dim_service</i>
  }

  entity "**kpi_actes_type**\n<i>évolution · KPI 3</i>" as g_actes_type #E0F2F1 {
    grain : <b>code CCAM</b>
    --
    libelle · tarif_euros
    nb_actes · part_pct
    montant_facture_euros
  }
}

' ══════════════════════ GOLD RECHERCHE ══════════════════════
package "eds_gold_recherche — user SQL : chu_recherche (SELECT only)" as gold_r #F3E5F5 {

  entity "**prevalence_pathologie**\n<i>KPI 5</i>" as g_preval {
    grain : code CIM-10
    --
    libelle · nb_patients · nb_sejours
    prevalence_pct · nb_patients_total
    <b>diffusable</b> : Bool
    --
    <i>tous rangs de diagnostic</i>
    <i>13 lignes, 11 effectifs publiés</i>
  }

  entity "**cohorte_demographie**\n<i>KPI 6</i>" as g_demo {
    grain : CIM-10 × tranche d'âge
    ....... × sexe
    --
    nb_patients · <b>diffusable</b> : Bool
    --
    <i>diagnostic PRINCIPAL uniquement</i>
    <i>= motif d'hospitalisation</i>
    <i>102 cellules, 89 effectifs publiés</i>
  }

  entity "**cohorte_demographie_globale**" as g_demo_glob {
    grain : sexe × tranche d'âge
    --
    {field} nb_patients (comptés une fois)
    <b>diffusable</b> : Bool
    --
    <i>mesure non additive : ce grain</i>
    <i>ne se dérive pas des autres</i>
  }

  entity "**k_anonymat_controle**\n<i>preuve du dispositif</i>" as g_kanon {
    grain : vue protégée
    --
    cellules_calculees
    cellules_diffusees
    cellules_masquees · seuil_k
    --
    <i>dit COMBIEN de cellules sont</i>
    <i>masquées, jamais lesquelles</i>
  }
}

' ══════════════════════════ OPS ═════════════════════════════
package "ops — traçabilité & exploitation (chu_etl uniquement)" as ops #FFF3E0 {

  entity "**ingest_log**" as o_ingest {
    domain · ingest_date
    source_file · sha256
    rows_source · rows_loaded
    status · error · run_id
    started_at · finished_at
  }

  entity "**pipeline_runs**" as o_runs {
    run_id : String
    started_at · finished_at
    status · days_processed
    files_ok · files_failed · error
    {field} updated_at <i>(version Replacing)</i>
  }

  entity "**quality_report**" as o_quality {
    run_id · layer · table_name
    rule · rule_label
    rows_in · rows_kept
    {field} <b>rows_rejected</b> (retirées)
    {field} <b>rows_flagged</b> (marquées)
    details · checked_at
    <i>TTL : 1 an</i>
  }
}

' ══════════════════ FLUX ENTRE COUCHES ══════════════════════
bronze -[#37474F,bold]down-> silver : <b>SQL in-engine</b> : dédup argMax\nrègles qualité Q1→Q8 · rejets tracés
silver -[#1565C0,bold]down-> gold_p : agrégation KPI
silver -[#6A1B9A,bold]down-> gold_r : agrégation cohortes\n<b>masquage des cellules < 5 patients</b>
silver .[#EF6C00]down.> ops : comptages par règle


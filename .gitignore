# Zone de travail (lake, volumes) : dérivée, reconstructible
# Le dépôt du CHU (source-filestorage/) est versionné : c'est le jeu de données
# synthétique de l'épreuve, pour que le projet se lance après un simple clone.
data/

# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Logs & artefacts locaux
logs/
*.log

# dbt : manifeste, artefacts compilés, journaux
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Terraform : l'état contient les mots de passe générés et l'URL SAS du lake.
# `terraform/.gitignore` couvre le détail ; ces motifs sont la ceinture.
*.tfstate
*.tfstate.*
.terraform/
terraform/terraform.tfvars
terraform/backend.hcl

# OS / IDE / outillage
.DS_Store
.idea/
.vscode/
.claude/

# Dossiers de dépôt bruts remis par l'intervenant : leur contenu est recopié dans
# source-filestorage/, qui seul fait foi et est versionné.
source-evolution/
source-filestorage-corrigé/
# Jeu initial de l'épreuve (3 jours), remplacé par le jeu corrigé le 2 septembre 2026 :
# conservé pour mémoire, jamais chargé, jamais versionné.
source-filestorage-initial/

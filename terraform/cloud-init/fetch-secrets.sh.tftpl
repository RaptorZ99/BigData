#!/usr/bin/env bash
# Récupère les secrets dans Key Vault et compose le fichier d'environnement de la pile.
#
# Aucune dépendance à `azure-cli` : deux appels HTTP suffisent, et installer 500 Mo
# d'outillage sur une machine qui en a 4 Gio serait absurde. Le jeton vient d'IMDS,
# l'adresse de métadonnées locale que seule cette machine peut interroger.
set -euo pipefail

COFFRE="${key_vault_name}"
CIBLE=/opt/eds/.env

jeton() {
  curl -sS -H Metadata:true --retry 5 --retry-delay 3 \
    "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net" \
    | jq -r .access_token
}

JETON="$(jeton)"

secret() {
  curl -sS -H "Authorization: Bearer $JETON" --retry 5 --retry-delay 3 \
    "https://$COFFRE.vault.azure.net/secrets/$1?api-version=7.4" | jq -r .value
}

# Écriture atomique, en 0600 et propriété de root : un fichier d'environnement à
# demi écrit ferait démarrer la pile avec un mot de passe tronqué.
TMP="$(mktemp)"
chmod 600 "$TMP"
{
  echo "CLICKHOUSE_ETL_PASSWORD=$(secret clickhouse-etl-password)"
  echo "MB_SITE_URL_UNUSED=1"
} > "$TMP"
mv "$TMP" "$CIBLE"
chown root:root "$CIBLE"
chmod 600 "$CIBLE"

# L'URL SAS ne va pas dans l'environnement mais dans la configuration du serveur :
# elle devient une collection nommée, et n'apparaît alors ni dans le SQL envoyé,
# ni dans `system.query_log`, ni dans les journaux du pipeline.
#
# Les esperluettes de l'URL doivent être échappées : un `&` nu rendrait le XML
# invalide et ClickHouse refuserait de démarrer.
SAS="$(secret lake-sas-url | sed 's/&/\&amp;/g')"
cat > /opt/eds/clickhouse/config.d/lake.xml <<XML
<clickhouse>
    <named_collections>
        <lake>
            <storage_account_url>$SAS</storage_account_url>
            <container>lake</container>
        </lake>
    </named_collections>
</clickhouse>
XML
chmod 640 /opt/eds/clickhouse/config.d/lake.xml

<clickhouse>
    <users>
        <chu_etl>
            <!--
                Sans ces deux réglages, la collection nommée `lake` est déclarée mais
                inutilisable : toute requête échoue sur
                « necessary to have the grant NAMED COLLECTION ON lake ».

                Et un `GRANT` ne rattraperait rien : `chu_etl` est défini en XML, et
                ClickHouse refuse de modifier un utilisateur de ce stockage
                (ACCESS_STORAGE_READONLY). C'est donc ici, et nulle part ailleurs,
                que l'accès au lake se décide.
            -->
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
        </chu_etl>
    </users>
</clickhouse>
